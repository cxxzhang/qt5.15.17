diff --git a/src/corelib/global/qtypeinfo.h b/src/corelib/global/qtypeinfo.h
--- a/src/corelib/global/qtypeinfo.h
+++ b/src/corelib/global/qtypeinfo.h
@@ -53,8 +53,10 @@
 static constexpr bool qIsRelocatable()
 {
-#if defined(Q_CC_CLANG) || !defined(Q_CC_GNU) || Q_CC_GNU >= 501
+#if defined(Q_CC_CLANG)
+    return __is_trivially_copyable(T) && __is_trivially_destructible(T);
+#elif !defined(Q_CC_GNU) || Q_CC_GNU >= 501
     return std::is_trivially_copyable<T>::value && std::is_trivially_destructible<T>::value;
 #else
     return std::is_enum<T>::value || std::is_integral<T>::value;
 #endif
 }
diff --git a/src/corelib/itemmodels/qabstractitemmodel.cpp b/src/corelib/itemmodels/qabstractitemmodel.cpp
--- a/src/corelib/itemmodels/qabstractitemmodel.cpp
+++ b/src/corelib/itemmodels/qabstractitemmodel.cpp
@@ -218,2 +218,2 @@ bool QPersistentModelIndex::operator<(const QPersistentModelIndex &other) const
-    return std::less<>{}(d, other.d);
+    return std::less<decltype(d)>{}(d, other.d);
 }
diff --git a/src/3rdparty/harfbuzz-ng/src/hb-meta.hh b/src/3rdparty/harfbuzz-ng/src/hb-meta.hh
--- a/src/3rdparty/harfbuzz-ng/src/hb-meta.hh
+++ b/src/3rdparty/harfbuzz-ng/src/hb-meta.hh
@@ -202,3 +202,11 @@
-#if defined(__GNUC__) && __GNUC__ < 5 && !defined(__clang__)
+#if defined(__clang__)
+template <typename T, bool = std::is_copy_assignable<T>::value> struct hb_clang_trivial_copy_assign : hb_false_type {};
+template <typename T> struct hb_clang_trivial_copy_assign<T, true> : hb_bool_constant<__is_trivially_assignable(T&, const T&)> {};
+#define hb_is_trivially_copyable(T) __is_trivially_copyable(T)
+#define hb_is_trivially_copy_assignable(T) hb_clang_trivial_copy_assign<T>::value
+#define hb_is_trivially_constructible(T) __is_trivially_constructible(T)
+#define hb_is_trivially_copy_constructible(T) __is_trivially_constructible(T, typename std::add_lvalue_reference<typename std::add_const<T>::type>::type)
+#define hb_is_trivially_destructible(T) __is_trivially_destructible(T)
+#elif defined(__GNUC__) && __GNUC__ < 5
 #define hb_is_trivially_copyable(T) __has_trivial_copy(T)
 #define hb_is_trivially_copy_assignable(T) __has_trivial_assign(T)
